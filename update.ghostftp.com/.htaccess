Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^downloads/?$ - [F,END]
RewriteRule ^downloads/(?:SHA256SUMS\.txt|__GHOSTFTP_RELEASE_INSTALLERS__)$ - [END]
RewriteRule ^downloads/ - [R=404,END]
RewriteRule ^manual-version\.json$ manual-version.php [END]
RewriteRule ^(?:updates/)?latest\.json$ updates/index.php [END]
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
</IfModule>
<FilesMatch "^\.">
Require all denied
</FilesMatch>
