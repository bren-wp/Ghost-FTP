{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost FTP",
  "version": "0.20.2",
  "identifier": "com.ghostftp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "ghostftp"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://ghostftp.com/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MzQ2NEEwRDBENEE5OTcKUldTWHFkVFFvR1EwR0s3NGpQeEcvcEptVUNqanFZdXNsQVF1dFBnNHhqalpLWVQvcnhsTy9mVHYK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Brendigo",
    "homepage": "https://github.com/bren-wp/Ghost-FTP",
    "category": "Utility",
    "copyright": "Copyright © 2026 Brendigo. All rights reserved.",
    "shortDescription": "Ghost FTP — secure FTP, FTPS and SFTP file transfer for Windows and Linux.",
    "longDescription": "Ghost FTP is a privacy-first native file transfer client for FTP, explicit FTPS and SFTP with saved sites, transfer queues, synchronization, checksums, permissions, terminal tools and secure connection verification.",
    "licenseFile": "../../EULA.txt",
    "windows": {
      "nsis": {
        "compression": "lzma",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "nsis/ghostftp-header.bmp",
        "sidebarImage": "nsis/ghostftp-sidebar.bmp",
        "uninstallerHeaderImage": "nsis/ghostftp-header.bmp",
        "installMode": "currentUser",
        "languages": [
          "English",
          "Croatian"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Ghost FTP"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
