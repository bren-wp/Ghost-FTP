Options -Indexes

<IfModule mod_headers.c>
  <Files "latest.json">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-Content-Type-Options "nosniff"
  </Files>
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
</IfModule>
