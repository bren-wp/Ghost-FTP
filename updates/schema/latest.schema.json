{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostftp.com/updates/schema/latest.schema.json",
  "title": "Ghost FTP Desktop Update Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "platforms"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)$"
    },
    "notes": {
      "type": "string"
    },
    "pub_date": {
      "type": "string",
      "format": "date-time"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows-x86_64",
        "linux-x86_64"
      ],
      "properties": {
        "windows-x86_64": {
          "$ref": "#/$defs/package"
        },
        "linux-x86_64": {
          "$ref": "#/$defs/package"
        }
      }
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "signature"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "signature": {
          "type": "string",
          "minLength": 16
        }
      }
    }
  }
}
