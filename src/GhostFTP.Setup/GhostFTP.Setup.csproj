<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>GhostFTP.Setup</RootNamespace>
    <AssemblyName>GhostFTP-Setup</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GhostFtpPayloadPath Condition="'$(GhostFtpPayloadPath)' == ''">..\..\artifacts\portable\GhostFTP.exe</GhostFtpPayloadPath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(GhostFtpPayloadPath)')">
    <EmbeddedResource Include="$(GhostFtpPayloadPath)" LogicalName="GhostFTP.PortablePayload.exe" />
  </ItemGroup>
</Project>
