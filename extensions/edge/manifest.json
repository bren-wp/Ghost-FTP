{
  "manifest_version": 3,
  "name": "Ghost FTP Connection Helper",
  "short_name": "Ghost FTP",
  "version": "0.0.6",
  "description": "Manage FTP, FTPS and SFTP connections through the local Ghost FTP bridge without browser credential storage.",
  "homepage_url": "https://ghostftp.com",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon.png",
    "32": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_title": "Ghost FTP Connection Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "32": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  }
}
